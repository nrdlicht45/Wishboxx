# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/wishboxx.db

# Claude API für KI-Geschenkvorschläge (ohne Key wird ein regelbasierter Katalog genutzt)
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben
AI_MODEL=claude-opus-5-5

# Diese E-Mail wird beim Registrieren automatisch Admin (sonst: erster registrierter User)
ADMIN_EMAIL=

# Öffentliche Basis-URL (für Teilen-Links)
APP_URL=http://localhost:3000

# E-Mail (Reservierungsbestätigung & Erinnerungen). Ohne SMTP_HOST nur Log-Ausgabe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wishboxx <noreply@example.com>"

# Schützt /api/cron/reminders (täglich aufrufen, z.B. Railway Cron oder GitHub Actions)
CRON_SECRET=

# NUR ZUM TESTEN: Login-Links ohne Mailversand direkt anzeigen (niemals im Live-Betrieb setzen!)
SHOW_LOGIN_LINKS=
